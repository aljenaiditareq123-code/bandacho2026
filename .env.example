# ============================================================
#  BANDA CHAO - Environment Configuration Template
# ============================================================

# ── Application ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="BandaChao"

# ── Database ─────────────────────────────────────────────
DATABASE_URL=file:./prisma/prisma/dev.db

# ── Auth (Mock Session) ──────────────────────────────────
# 32+ char random secret used to encrypt session cookie (iron-session)
SESSION_SECRET=REPLACE_WITH_32_CHAR_RANDOM_STRING_HERE
FOUNDER_EMAIL=founder@bandachao.com
FOUNDER_PASSWORD=demo123

# ── Currency FX (demo static, hardcoded if not provided) ─
FX_RMB_TO_AED=0.51
FX_AED_TO_USD=0.2723
FX_AED_TO_SAR=1.0209
